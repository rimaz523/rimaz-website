<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>e74dc12b-b750-458a-9ab9-5f783d1518b6</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\Application.csproj" />
    <ProjectReference Include="..\Infrastructure\Infrastructure.csproj" />
  </ItemGroup>

  <Target Name="CreateSwaggerJson"
          AfterTargets="Build"
          Condition="'$(Configuration)' == 'Debug' And '$(DesignTimeBuild)' != 'true' And Exists('$(TargetPath)')">
    <Exec Command="dotnet swagger tofile --output swagger.json &quot;$(TargetPath)&quot; v1"
          WorkingDirectory="$(ProjectDir)"
          EnvironmentVariables="SWAGGER_GEN=true"
          ContinueOnError="WarnAndContinue" />
  </Target>
</Project>
